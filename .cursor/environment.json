{
  "name": "AI Cabin Copilot",
  "install": "./.cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && ../.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host --port 5173"
    }
  ],
  "ports": [
    { "name": "backend", "port": 8000 },
    { "name": "frontend", "port": 5173 }
  ]
}
