# Copy to .env and fill in real values to use live Azure services.
# With MOCK_MODE=true (default) everything runs locally with deterministic mocks
# and no keys are required.

MOCK_MODE=true

# Azure OpenAI (chat + tool calling)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure Speech Services (STT/TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Live traffic: TomTom (free developer key) or Azure Maps. Leave both
# empty to use OpenStreetMap Nominatim + OSRM (real distances, no traffic).
TOMTOM_API_KEY=
AZURE_MAPS_KEY=

# mock = offline table (CI). osm = Nominatim + OSRM.
# tomtom / azure = that provider. auto = TomTom, else Azure, else OSM.
MAPS_BACKEND=auto

# json = local seed meetings. graph = Outlook via Microsoft Graph.
# For Graph: register an Azure AD public client, enable device code flow,
# add delegated Calendars.Read, then Connect Outlook on the dashboard.
CALENDAR_BACKEND=json
AZURE_AD_TENANT_ID=common
AZURE_AD_CLIENT_ID=

# Vehicle signal transport: sim (in-process) or can (python-can virtual bus)
VEHICLE_BUS=sim
