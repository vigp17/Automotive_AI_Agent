# Copy to .env and fill in real values to use live Azure services.
# With MOCK_MODE=true (default) everything runs locally with deterministic mocks
# and no keys are required.

MOCK_MODE=true

# Azure OpenAI (chat + tool calling)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure Speech Services (STT/TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure Maps (routing, ETA, traffic). Leave empty to use OpenStreetMap
# Nominatim + OSRM for real driving distances with no key.
AZURE_MAPS_KEY=

# mock = offline table (CI). osm = real geocode + road distance (default).
# azure = Azure Maps (requires AZURE_MAPS_KEY).
MAPS_BACKEND=osm

# Vehicle signal transport: sim (in-process) or can (python-can virtual bus)
VEHICLE_BUS=sim
